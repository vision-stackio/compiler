# Demo Vision Script — exercises eyes, movement, and speech
EYE_CENTER
AUDIO_SPEAK "Hello! Watch my eyes."
WAIT 500

REPEAT 3 TIMES AS $step
  EYE_LEFT 20
  WAIT 300
  EYE_RIGHT 20
  WAIT 300
END

EYE_SET 150
WAIT 400
EYE_SET 30
WAIT 400
EYE_CENTER

WALK_FORWARD 1200
WAIT 1200
TURN_LEFT 600
WAIT 600
TURN_RIGHT 600
WAIT 600
WALK_STOP

AUDIO_SPEAK "Time to dance!"
DANCE 2000
WAIT 2000

PRINT "Subham:)"
